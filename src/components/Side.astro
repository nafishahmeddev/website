---
import Eyebrow from './Eyebrow.astro';
import { side } from '../data/profile';
---

<section class="section" id="side" aria-labelledby="side-title">
  <div class="wrap">
    <Eyebrow n="03" label="Libraries and side projects" />
    <h2 id="side-title" class="sr-only">Libraries and side projects</h2>
    <ul class="side">
      {side.map((s, i) => (
        <li class="side__item" data-reveal style={`--i:${i}`}>
          <p class="side__what label">{s.what}</p>
          <h3 class="side__name">{s.name}</h3>
          <p class="side__detail">{s.detail}</p>
          <div class="tags">{s.stack.map((t) => <span class="tag">{t}</span>)}</div>
          {s.href && <a class="side__link link mono" href={s.href} data-cursor="Open" data-sfx={i}>{s.linkLabel} ↗</a>}
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .side {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: var(--s-6);
    margin-top: var(--s-7);
  }
  .side__item {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-top: var(--s-5);
    border-top: 1px solid var(--c-line-strong);
  }
  .side__name {
    font-size: var(--t-title);
    letter-spacing: var(--tr-snug);
  }
  .side__detail {
    color: var(--c-text-soft);
    font-size: var(--t-small);
  }
  .side__link {
    align-self: flex-start;
    margin-top: auto;
    padding-top: var(--s-3);
    font-size: var(--t-small);
    color: var(--c-accent-hi);
  }
  @media (max-width: 1080px) {
    .side {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 560px) {
    .side {
      grid-template-columns: 1fr;
    }
  }
</style>
