---
import Eyebrow from './Eyebrow.astro';
import { faqs } from '../data/profile';
---

<section class="section" id="faq" aria-labelledby="faq-title">
  <div class="wrap faq">
    <div>
      <Eyebrow n="04" label="Questions" />
      <h2 id="faq-title" class="heading faq__h" data-reveal>The short <em>answers.</em></h2>
    </div>
    <div class="faq__list">
      {faqs.map((f, i) => (
        <details class="qa" data-reveal style={`--i:${i}`} name="faq">
          <summary data-sfx={i}><h3>{f.q}</h3><span class="qa__icon" aria-hidden="true"></span></summary>
          <p>{f.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .faq {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.25fr);
    gap: var(--s-8);
  }
  .faq__h {
    margin-top: var(--s-6);
  }
  .faq__list {
    border-top: 1px solid var(--c-line-strong);
  }
  .qa {
    border-bottom: 1px solid var(--c-line-strong);
  }
  .qa summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-5);
    cursor: pointer;
    list-style: none;
  }
  .qa summary::-webkit-details-marker {
    display: none;
  }
  .qa h3 {
    font-size: var(--t-lead);
    letter-spacing: -0.015em;
    transition: color var(--d-fast);
  }
  .qa summary:hover h3 {
    color: var(--c-accent-hi);
  }
  .qa__icon {
    position: relative;
    flex: none;
    width: 14px;
    height: 14px;
  }
  .qa__icon::before,
  .qa__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: currentColor;
    transition: transform var(--d-base) var(--ease-out);
  }
  .qa__icon::after {
    transform: rotate(90deg);
  }
  .qa[open] .qa__icon::after {
    transform: none;
  }
  .qa p {
    padding-bottom: var(--s-5);
    max-width: 62ch;
    color: var(--c-text-soft);
  }
  .qa::details-content {
    block-size: 0;
    overflow: hidden;
    transition: block-size var(--d-base) var(--ease-out), content-visibility var(--d-base) allow-discrete;
  }
  .qa[open]::details-content {
    block-size: auto;
  }
  @supports (interpolate-size: allow-keywords) {
    :root {
      interpolate-size: allow-keywords;
    }
  }
  @media (max-width: 900px) {
    .faq {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
  }
</style>
