---
// Nafish in pixels. Drawn on a canvas from src/data/pixel-me.ts: the pixels
// develop out of the cobalt when the page opens, and on hover they scatter
// and snap back.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: cls } = Astro.props;
---

<canvas class:list={['pxme', cls]} width="48" height="48" style={`--px-size:${size}px`} data-pxme role="img" aria-label="Pixel portrait of Nafish Ahmed"></canvas>

<script>
  import { pixelMe, pixelPalette, pixelSize as N } from '../data/pixel-me';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const mid = (N - 1) / 2;
  type Px = { x: number; y: number; c: string; ground: boolean };
  const all: Px[] = [];
  pixelMe.forEach((row, y) =>
    [...row].forEach((ch, x) => {
      // A circle stepped on the pixel grid, like the round original. A smooth
      // CSS crop would cut pixels in half.
      if ((x - mid) ** 2 + (y - mid) ** 2 > (N / 2 + 0.2) ** 2) return;
      all.push({ x, y, c: pixelPalette[ch], ground: ch === 'B' || ch === 'b' });
    }),
  );
  const ground = all.filter((p) => p.ground);
  const figure = all.filter((p) => !p.ground);

  document.querySelectorAll<HTMLCanvasElement>('[data-pxme]').forEach((canvas) => {
    const ctx = canvas.getContext('2d')!;
    // Each figure pixel lands at a random moment, so he develops out of the ground.
    const fig = figure.map((p) => ({ ...p, t: Math.random() }));
    let start = performance.now();
    let scatter = 0;
    let scatterTarget = 0;

    const paint = (now: number) => {
      const k = still ? 1 : Math.min(1, (now - start) / 1000);
      ctx.clearRect(0, 0, N, N);
      for (const p of ground) {
        ctx.fillStyle = p.c;
        ctx.fillRect(p.x, p.y, 1, 1);
      }
      for (const p of fig) {
        if (p.t > k) continue;
        let { x, y } = p;
        if (scatter > 0.01) {
          // Push each pixel away from the centre of the face.
          const dx = x - mid;
          const dy = y - mid;
          const d = Math.hypot(dx, dy) || 1;
          const push = scatter * (2 + p.t * 4);
          x = Math.round(x + (dx / d) * push);
          y = Math.round(y + (dy / d) * push);
        }
        ctx.fillStyle = p.c;
        ctx.fillRect(x, y, 1, 1);
      }
    };

    if (still) {
      paint(performance.now());
      return;
    }

    const loop = (now: number) => {
      scatter += (scatterTarget - scatter) * 0.18;
      paint(now);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    const host = canvas.closest('a, button') ?? canvas;
    host.addEventListener('pointerenter', () => (scatterTarget = 1));
    host.addEventListener('pointerleave', () => (scatterTarget = 0));
    host.addEventListener('pointerdown', () => {
      start = performance.now();
      fig.forEach((p) => (p.t = Math.random()));
    });
  });
</script>

<style>
  .pxme {
    display: block;
    width: var(--px-size);
    height: var(--px-size);
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    flex: none;
  }
</style>
