---
// Nafish in pixels. Drawn on a canvas from src/data/pixel-me.ts: the pixels
// assemble when the page opens, he blinks now and then, and on hover the
// pixels scatter and snap back.
interface Props {
  size?: number;
  class?: string;
}
const { size = 40, class: cls } = Astro.props;
---

<canvas class:list={['pxme', cls]} width="32" height="32" style={`--px-size:${size}px`} data-pxme role="img" aria-label="Pixel portrait of Nafish Ahmed"></canvas>

<script>
  import { pixelMe, pixelPalette, pixelEyes } from '../data/pixel-me';

  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const N = 32;
  type Px = { x: number; y: number; c: string };
  const all: Px[] = [];
  pixelMe.forEach((row, y) => [...row].forEach((ch, x) => all.push({ x, y, c: pixelPalette[ch] })));
  // A circle stepped on the pixel grid, like the round original. A smooth
  // CSS crop would cut pixels in half.
  const inCircle = (p: Px) => (p.x - 15.5) ** 2 + (p.y - 15.5) ** 2 <= 16.2 ** 2;
  const ground = all.filter((p) => inCircle(p) && (p.c === pixelPalette.B || p.c === pixelPalette.b));
  const figure = all.filter((p) => inCircle(p) && p.c !== pixelPalette.B && p.c !== pixelPalette.b);
  const eyes = new Set(pixelEyes.map(([x, y]) => y * N + x));

  document.querySelectorAll<HTMLCanvasElement>('[data-pxme]').forEach((canvas) => {
    const ctx = canvas.getContext('2d')!;
    // Each figure pixel lands at a random moment, so he assembles out of the ground.
    const fig = figure.map((p) => ({ ...p, t: Math.random() }));
    let start = performance.now();
    let blinkUntil = 0;
    let scatter = 0;
    let scatterTarget = 0;

    const paint = (now: number) => {
      const k = still ? 1 : Math.min(1, (now - start) / 900);
      const blinking = now < blinkUntil;
      ctx.clearRect(0, 0, N, N);
      for (const p of ground) {
        ctx.fillStyle = p.c;
        ctx.fillRect(p.x, p.y, 1, 1);
      }
      for (const p of fig) {
        if (p.t > k) continue;
        let { x, y } = p;
        if (scatter > 0.01) {
          // Push each pixel away from the centre of the face.
          const dx = x - 15.5;
          const dy = y - 15;
          const d = Math.hypot(dx, dy) || 1;
          const push = scatter * (2.2 + (p.t * 3));
          x = Math.round(x + (dx / d) * push);
          y = Math.round(y + (dy / d) * push);
        }
        const isEye = eyes.has(p.y * N + p.x);
        ctx.fillStyle = blinking && isEye ? pixelPalette.S : p.c;
        ctx.fillRect(x, y, 1, 1);
      }
      if (blinking) {
        // Closed eyes: a short dark line under where the pupils were.
        ctx.fillStyle = pixelPalette.K;
        ctx.fillRect(10, 15, 4, 1);
        ctx.fillRect(18, 15, 4, 1);
      }
      return k;
    };

    if (still) {
      paint(performance.now());
      return;
    }

    const loop = (now: number) => {
      scatter += (scatterTarget - scatter) * 0.18;
      paint(now);
      requestAnimationFrame(loop);
    };
    requestAnimationFrame(loop);

    const blink = () => {
      blinkUntil = performance.now() + 140;
      setTimeout(blink, 2800 + Math.random() * 3600);
    };
    setTimeout(blink, 2200);

    const host = canvas.closest('a, button') ?? canvas;
    host.addEventListener('pointerenter', () => (scatterTarget = 1));
    host.addEventListener('pointerleave', () => (scatterTarget = 0));
    host.addEventListener('pointerdown', () => {
      start = performance.now();
      fig.forEach((p) => (p.t = Math.random()));
    });
  });
</script>

<style>
  .pxme {
    display: block;
    width: var(--px-size);
    height: var(--px-size);
    image-rendering: pixelated;
    image-rendering: crisp-edges;
    flex: none;
  }
</style>
