---
import { profile } from '../data/profile';

const nav = [
  { href: '#work', label: 'Work' },
  { href: '#studio', label: 'Studio' },
  { href: '#experience', label: 'Experience' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="hdr" data-header>
  <div class="hdr__in wrap">
    <a class="hdr__mark" href="#top" aria-label={`${profile.name}, back to top`} data-sfx="0">
      <span class="hdr__mono">NA</span>
      <span class="hdr__name">{profile.name}</span>
    </a>

    <nav class="hdr__nav" aria-label="Sections">
      {nav.map((n, i) => <a class="hdr__link" href={n.href} data-sfx={i + 1}><span>{n.label}</span><span aria-hidden="true">{n.label}</span></a>)}
    </nav>

    <div class="hdr__tools">
      <p class="hdr__clock mono" title="Local time in Bengaluru (IST, UTC+5:30)">
        <span class="sr-only">Local time in {profile.city}: </span>BLR <span data-clock>--:--</span>
      </p>
      <button class="hdr__btn hdr__sound" type="button" data-sound-toggle aria-pressed="false" aria-label="Interface sound">
        <span class="bars" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
        <span class="hdr__sound-text mono"><span class="on">Sound on</span><span class="off">Sound off</span></span>
      </button>
      <button class="hdr__btn" type="button" data-theme-toggle aria-label="Switch light or dark theme">
        <svg viewBox="0 0 20 20" width="18" height="18" aria-hidden="true"><circle cx="10" cy="10" r="7.25" fill="none" stroke="currentColor" stroke-width="1.5" /><path d="M10 2.75a7.25 7.25 0 0 1 0 14.5Z" fill="currentColor" /></svg>
      </button>
    </div>
  </div>
</header>

<style>
  .hdr {
    position: fixed;
    inset: 0 0 auto;
    z-index: var(--z-header);
    padding-block: var(--s-4);
    transition:
      transform var(--d-base) var(--ease-out),
      background-color var(--d-base) var(--ease-out);
  }
  .hdr.is-scrolled {
    background: var(--c-overlay);
    backdrop-filter: blur(14px) saturate(1.2);
    -webkit-backdrop-filter: blur(14px) saturate(1.2);
    box-shadow: 0 1px 0 var(--c-line);
  }
  .hdr.is-hidden {
    transform: translateY(-100%);
  }
  .hdr__in {
    display: flex;
    align-items: center;
    gap: var(--s-5);
  }
  .hdr__mark {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .hdr__mono {
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--c-accent);
    color: var(--c-accent-ink);
    font-family: var(--f-mono);
    font-size: 11px;
    font-weight: 600;
    letter-spacing: 0.02em;
    transition: transform var(--d-base) var(--ease-out);
  }
  .hdr__mark:hover .hdr__mono {
    transform: rotate(-90deg);
  }
  .hdr__nav {
    display: flex;
    gap: var(--s-5);
    margin-inline: auto;
  }
  /* Label rolls up and is replaced by its copy. */
  .hdr__link {
    position: relative;
    display: grid;
    overflow: hidden;
    font-size: var(--t-small);
    color: var(--c-text-soft);
    height: 1.4em;
    line-height: 1.4;
  }
  .hdr__link span {
    grid-area: 1 / 1;
    transition: transform var(--d-base) var(--ease-out);
  }
  .hdr__link span + span {
    transform: translateY(100%);
    color: var(--c-text);
  }
  .hdr__link:hover span:first-child {
    transform: translateY(-100%);
  }
  .hdr__link:hover span + span {
    transform: none;
  }
  .hdr__tools {
    display: flex;
    align-items: center;
    gap: var(--s-2);
  }
  .hdr__clock {
    margin-right: var(--s-3);
    color: var(--c-mute);
    font-size: var(--t-micro);
    letter-spacing: var(--tr-label);
  }
  .hdr__btn {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    height: 36px;
    min-width: 36px;
    padding-inline: 10px;
    justify-content: center;
    border-radius: var(--r-pill);
    box-shadow: inset 0 0 0 1px var(--c-line-strong);
    color: var(--c-text-soft);
    transition:
      color var(--d-fast),
      box-shadow var(--d-fast);
  }
  .hdr__btn:hover {
    color: var(--c-text);
    box-shadow: inset 0 0 0 1px var(--c-text);
  }
  .hdr__sound-text {
    font-size: var(--t-micro);
    letter-spacing: var(--tr-label);
    text-transform: uppercase;
  }
  :global(html[data-sound='on']) .off,
  :global(html[data-sound='off']) .on {
    display: none;
  }
  /* Four bars that dance while sound is on. */
  .bars {
    display: inline-flex;
    align-items: center;
    gap: 2px;
    height: 12px;
  }
  .bars i {
    width: 2px;
    height: 3px;
    border-radius: 1px;
    background: currentColor;
    transition: height var(--d-base) var(--ease-out);
  }
  :global(html[data-sound='on']) .bars i {
    animation: bar 900ms var(--ease-in-out) infinite alternate;
    color: var(--c-accent-hi);
  }
  :global(html[data-sound='on']) .bars i:nth-child(2) { animation-delay: -300ms; }
  :global(html[data-sound='on']) .bars i:nth-child(3) { animation-delay: -600ms; }
  :global(html[data-sound='on']) .bars i:nth-child(4) { animation-delay: -150ms; }
  @keyframes bar {
    to { height: 12px; }
  }

  @media (max-width: 900px) {
    .hdr__nav,
    .hdr__clock,
    .hdr__name {
      display: none;
    }
    .hdr__tools {
      margin-left: auto;
    }
  }
  @media (max-width: 420px) {
    .hdr__sound-text {
      display: none;
    }
  }
</style>
