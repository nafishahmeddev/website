---
import Eyebrow from './Eyebrow.astro';
import Split from './Split.astro';
import { profile, studioApps } from '../data/profile';

const groups = [
  { label: 'On Google Play', apps: studioApps.filter((a) => a.live) },
  { label: 'In progress', apps: studioApps.filter((a) => !a.live) },
];
---

<section class="section studio" id="studio" aria-labelledby="studio-title">
  <div class="wrap">
    <Eyebrow n="02" label={`${profile.studio.name} — the studio`} />
    <div class="studio__head">
      <Split id="studio-title" class="heading" lines={['My own apps,', '*on your phone.*']} />
      <div class="studio__intro" data-reveal>
        <p class="lead">I founded <a class="link" href={profile.studio.url}>{profile.studio.name}</a>, an independent app studio in {profile.city}. Its apps cover money, reminders, pet health, home screen widgets and puzzle games. Most keep your data on the phone and need no account.</p>
        <a class="btn btn--ghost" href={profile.studio.url} data-magnetic="0.2" data-cursor="Visit">idexa.app <svg class="btn__arrow" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></a>
      </div>
    </div>

    <div class="index" data-index>
      {groups.map((g, gi) => (
        <div class="index__group">
          <h3 class="index__label label" data-reveal>
            {gi === 0 && <span class="dot-live" />}
            {g.label}
          </h3>
          <ul class="index__list">
            {g.apps.map((a, i) => (
              <li data-reveal style={`--i:${i}`}>
                <a class="idx" href={`${profile.studio.url}/${a.slug}/`} data-sfx={i + gi * 5} data-cursor="View" data-preview={`/apps/${a.slug}.webp`}>
                  <img class="idx__icon" src={`/apps/${a.slug}.webp`} alt="" width="44" height="44" loading="lazy" decoding="async" />
                  <span class="idx__name">{a.name}</span>
                  <span class="idx__kind label">{a.kind}</span>
                  <span class="idx__line">{a.line}</span>
                  <svg class="idx__arrow" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
                </a>
              </li>
            ))}
          </ul>
        </div>
      ))}

      <!-- Follows the pointer over the list and shows the app's icon, large. -->
      <div class="preview" data-preview-el aria-hidden="true">
        <img src="" alt="" width="200" height="200" data-preview-img />
      </div>
    </div>
  </div>
</section>

<script>
  const index = document.querySelector<HTMLElement>('[data-index]');
  const box = document.querySelector<HTMLElement>('[data-preview-el]');
  const img = document.querySelector<HTMLImageElement>('[data-preview-img]');
  const fine = matchMedia('(pointer: fine)').matches;
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (index && box && img && fine && !still) {
    const pos = { x: 0, y: 0 };
    const now = { x: 0, y: 0, tilt: 0 };
    let raf = 0;
    const tick = () => {
      const dx = pos.x - now.x;
      now.x += dx * 0.14;
      now.y += (pos.y - now.y) * 0.14;
      // Lean into the direction of travel.
      now.tilt += (Math.max(-18, Math.min(18, dx * 0.12)) - now.tilt) * 0.12;
      box.style.transform = `translate3d(${now.x}px, ${now.y}px, 0) rotate(${now.tilt}deg)`;
      raf = requestAnimationFrame(tick);
    };

    index.querySelectorAll<HTMLElement>('[data-preview]').forEach((row) => {
      row.addEventListener('pointerenter', () => {
        if (img.getAttribute('src') !== row.dataset.preview) img.src = row.dataset.preview!;
        box.classList.add('is-on');
      });
    });
    index.addEventListener('pointermove', (e) => {
      const r = index.getBoundingClientRect();
      pos.x = e.clientX - r.left;
      pos.y = e.clientY - r.top;
      if (!raf) {
        now.x = pos.x;
        now.y = pos.y;
        tick();
      }
    });
    index.addEventListener('pointerleave', () => {
      box.classList.remove('is-on');
      cancelAnimationFrame(raf);
      raf = 0;
    });
  }
</script>

<style>
  .studio__head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--s-7);
    margin-block: var(--s-7) var(--s-8);
  }
  .studio__intro {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    max-width: 44ch;
  }

  .index {
    position: relative;
    display: grid;
    gap: var(--s-8);
  }
  .index__label {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    font-weight: 400;
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-line-strong);
  }

  .idx {
    display: grid;
    grid-template-columns: 44px minmax(0, 1fr) minmax(0, 0.8fr) minmax(0, 1.4fr) 20px;
    align-items: center;
    gap: var(--s-5);
    padding-block: var(--s-5);
    border-bottom: 1px solid var(--c-line);
    transition: color var(--d-base) var(--ease-out);
  }
  .idx__icon {
    width: 44px;
    height: 44px;
    border-radius: 11px;
    box-shadow: 0 0 0 1px var(--c-line);
    transition:
      transform var(--d-base) var(--ease-out),
      opacity var(--d-base) var(--ease-out);
  }
  .idx__name {
    font-size: var(--t-title);
    font-weight: 500;
    letter-spacing: var(--tr-snug);
    line-height: 1.1;
    transition: transform var(--d-base) var(--ease-out);
  }
  .idx__kind {
    transition: color var(--d-base) var(--ease-out);
  }
  .idx__line {
    color: var(--c-text-soft);
    font-size: var(--t-small);
    transition: color var(--d-base) var(--ease-out);
  }
  .idx__arrow {
    width: 14px;
    height: 14px;
    justify-self: end;
    color: var(--c-mute);
    transition:
      transform var(--d-base) var(--ease-out),
      color var(--d-base) var(--ease-out);
  }

  /* The hovered row stays lit; the rest step back. */
  .index__list:hover .idx {
    color: var(--c-mute);
  }
  .index__list:hover .idx__line,
  .index__list:hover .idx__kind {
    color: color-mix(in srgb, var(--c-mute) 70%, transparent);
  }
  .index__list:hover .idx__icon {
    opacity: 0.35;
  }
  .index__list .idx:hover {
    color: var(--c-text);
  }
  .index__list .idx:hover .idx__name {
    transform: translateX(12px);
  }
  .index__list .idx:hover .idx__line {
    color: var(--c-text-soft);
  }
  .index__list .idx:hover .idx__kind {
    color: var(--c-accent-hi);
  }
  .index__list .idx:hover .idx__icon {
    opacity: 1;
    transform: scale(1.08) rotate(-6deg);
  }
  .index__list .idx:hover .idx__arrow {
    color: var(--c-accent-hi);
    transform: translate(3px, -3px);
  }

  .preview {
    position: absolute;
    left: 0;
    top: 0;
    z-index: 2;
    width: 200px;
    height: 200px;
    margin: -100px 0 0 -100px;
    pointer-events: none;
    opacity: 0;
    scale: 0.6;
    transition:
      opacity var(--d-base) var(--ease-out),
      scale var(--d-base) var(--ease-out);
  }
  .preview.is-on {
    opacity: 1;
    scale: 1;
  }
  .preview img {
    width: 100%;
    height: 100%;
    border-radius: 46px;
    box-shadow:
      0 30px 80px -20px rgb(0 0 0 / 0.6),
      0 0 0 1px var(--c-line-strong),
      0 0 120px -10px color-mix(in srgb, var(--c-accent) 45%, transparent);
  }
  /* The preview would cover the row's own text, so it sits to the side of the pointer. */
  .preview {
    translate: 140px 0;
  }

  @media (max-width: 1080px) {
    .idx {
      grid-template-columns: 44px minmax(0, 1fr) 20px;
      row-gap: var(--s-1);
    }
    .idx__icon {
      grid-row: span 3;
      align-self: start;
    }
    .idx__kind,
    .idx__line {
      grid-column: 2;
    }
    .idx__arrow {
      grid-column: 3;
      grid-row: 1;
    }
    .preview {
      display: none;
    }
  }
  @media (max-width: 900px) {
    .studio__head {
      grid-template-columns: 1fr;
    }
  }
</style>
