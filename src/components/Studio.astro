---
import Eyebrow from './Eyebrow.astro';
import Split from './Split.astro';
import { profile, studioApps } from '../data/profile';
---

<section class="section studio" id="studio" aria-labelledby="studio-title">
  <div class="wrap">
    <Eyebrow n="02" label={`${profile.studio.name} — the studio`} />
    <div class="studio__head">
      <Split id="studio-title" class="heading" lines={['My own apps,', '*on your phone.*']} />
      <div class="studio__intro" data-reveal>
        <p class="lead">I founded <a class="link" href={profile.studio.url}>{profile.studio.name}</a>, an independent app studio in {profile.city}. Its apps cover money, reminders, pet health and puzzle games. Most keep your data on the phone and need no account.</p>
        <a class="btn btn--ghost" href={profile.studio.url} data-magnetic="0.2" data-cursor="Visit">idexa.app <svg class="btn__arrow" viewBox="0 0 14 14" aria-hidden="true"><path d="M3 11 11 3M5 3h6v6" fill="none" stroke="currentColor" stroke-width="1.5" /></svg></a>
      </div>
    </div>

    <ul class="apps">
      {studioApps.map((a, i) => (
        <li data-reveal style={`--i:${i % 4}`}>
          <a class="app" href={`${profile.studio.url}/${a.slug}/`} data-sfx={i} data-cursor="View">
            <span class="app__top">
              <img class="app__icon" src={`/apps/${a.slug}.webp`} alt="" width="56" height="56" loading="lazy" decoding="async" />
              <span class:list={['app__status mono', a.live && 'is-live']}>{a.live ? <><span class="dot-live" /> On Google Play</> : 'In progress'}</span>
            </span>
            <span class="app__name">{a.name}</span>
            <span class="app__kind label">{a.kind}</span>
            <span class="app__line">{a.line}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .studio__head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    align-items: end;
    gap: var(--s-7);
    margin-block: var(--s-7) var(--s-8);
  }
  .studio__intro {
    display: grid;
    gap: var(--s-5);
    justify-items: start;
    max-width: 44ch;
  }
  .apps {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1px;
    background: var(--c-line);
    border: 1px solid var(--c-line);
    border-radius: var(--r-lg);
    overflow: hidden;
  }
  .apps li {
    display: flex;
  }
  .app {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: var(--s-2);
    padding: var(--s-5);
    min-height: 260px;
    background: color-mix(in srgb, var(--c-bg) 88%, transparent);
    backdrop-filter: blur(6px);
    transition: background-color var(--d-base) var(--ease-out);
  }
  .app:hover {
    background: var(--c-bg-raise);
  }
  .app__top {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: auto;
    padding-bottom: var(--s-6);
  }
  .app__icon {
    width: 56px;
    height: 56px;
    border-radius: 14px;
    box-shadow: 0 0 0 1px var(--c-line);
    transition: transform var(--d-base) var(--ease-out);
  }
  .app:hover .app__icon {
    transform: translateY(-4px) rotate(-6deg) scale(1.06);
  }
  .app__status {
    display: inline-flex;
    align-items: center;
    gap: var(--s-2);
    font-size: var(--t-micro);
    color: var(--c-mute);
  }
  .app__status.is-live {
    color: var(--c-text-soft);
  }
  .app__name {
    font-size: var(--t-title);
    font-weight: 500;
    letter-spacing: var(--tr-snug);
    line-height: 1.1;
  }
  .app__line {
    color: var(--c-text-soft);
    font-size: var(--t-small);
    max-width: 34ch;
    min-height: 3.2em;
  }
  @media (max-width: 1080px) {
    .apps {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 900px) {
    .studio__head {
      grid-template-columns: 1fr;
    }
  }
  @media (max-width: 560px) {
    .apps {
      grid-template-columns: 1fr;
    }
  }
</style>
