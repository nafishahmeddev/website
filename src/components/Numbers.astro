---
import { numbers, stack } from '../data/profile';
const ticker = stack.flatMap((g) => g.items);
---

<section class="nums" id="numbers" aria-label="In numbers">
  <div class="ticker" aria-hidden="true">
    <div class="ticker__track">
      {[0, 1].map(() => (
        <div class="ticker__set">
          {ticker.map((t) => <span class="ticker__item">{t}<span class="ticker__sep">✦</span></span>)}
        </div>
      ))}
    </div>
  </div>

  <div class="wrap">
    <dl class="nums__grid">
      {numbers.map((n, i) => (
        <div class="nums__cell" data-reveal style={`--i:${i}`}>
          <dt class="nums__label">{n.label}</dt>
          <dd class="nums__value" data-count={n.value}><span data-count-value>{n.value}</span>{n.suffix}</dd>
          <dd class="nums__note label">{n.note}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>

<style>
  .nums {
    position: relative;
    z-index: var(--z-page);
    padding-bottom: var(--section);
  }
  .ticker {
    overflow: hidden;
    border-block: 1px solid var(--c-line);
    padding-block: var(--s-5);
    margin-bottom: var(--section);
    mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
  }
  .ticker__track {
    display: flex;
    width: max-content;
    animation: ticker 60s linear infinite;
    /* Scroll speed leans the type: set by motion.ts. */
    transform: skewX(calc(var(--velocity, 0) * -8deg));
    transition: transform 300ms var(--ease-out);
  }
  .ticker:hover .ticker__track {
    animation-play-state: paused;
  }
  .ticker__set {
    display: flex;
    flex: none;
  }
  .ticker__item {
    display: inline-flex;
    align-items: center;
    gap: var(--s-6);
    padding-right: var(--s-6);
    font-size: var(--t-title);
    letter-spacing: var(--tr-snug);
    color: var(--c-text-soft);
    white-space: nowrap;
  }
  .ticker__sep {
    font-size: 0.5em;
    color: var(--c-accent-hi);
  }
  @keyframes ticker {
    to { translate: -50% 0; }
  }
  .nums__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    border-top: 1px solid var(--c-line);
  }
  .nums__cell {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding: var(--s-5) var(--s-5) 0 0;
  }
  .nums__cell + .nums__cell {
    padding-left: var(--s-5);
    border-left: 1px solid var(--c-line);
  }
  .nums__label {
    order: 2;
    max-width: 22ch;
    color: var(--c-text-soft);
  }
  .nums__value {
    order: 1;
    font-size: var(--t-head);
    line-height: 1;
    letter-spacing: var(--tr-tight);
    font-variant-numeric: tabular-nums;
  }
  .nums__note {
    order: 3;
  }
  @media (max-width: 900px) {
    .nums__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .nums__cell:nth-child(3) {
      padding-left: 0;
      border-left: 0;
    }
    .nums__cell:nth-child(n + 3) {
      margin-top: var(--s-6);
      border-top: 1px solid var(--c-line);
    }
  }
</style>
