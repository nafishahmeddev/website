---
import Split from './Split.astro';
import { profile, hero } from '../data/profile';
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="hero__in wrap">
    <div class="hero__meta" data-reveal style="--i:0">
      <p class="label hero__who"><strong>{profile.name}</strong> · {profile.role}</p>
      <p class="label">{profile.city}, {profile.country}</p>
      <p class="label hero__meta-end">Portfolio — {new Date(profile.updated).getFullYear()}</p>
    </div>

    <Split as="h1" id="hero-title" class="hero__title" lines={hero.lines} delay={150} />

    <div class="hero__foot">
      <p class="hero__summary lead" data-reveal style="--i:6">{hero.summary}</p>

      <div class="hero__cta" data-reveal style="--i:7">
        <a class="btn" href={`mailto:${profile.email}`} data-magnetic="0.25" data-cursor="Write">
          Email me
          <svg class="btn__arrow" viewBox="0 0 14 14" aria-hidden="true"><path d="M1 7h11M8 3l4 4-4 4" fill="none" stroke="currentColor" stroke-width="1.5" /></svg>
        </a>
        <a class="btn btn--ghost" href="#work" data-magnetic="0.25">See the work</a>
      </div>

      <div class="hero__now" data-reveal style="--i:8">
        <img class="hero__ava" src="/avatar.webp" alt={`Portrait of ${profile.name}`} width="72" height="72" decoding="async" />
        <dl>
          <div><dt class="label">Now</dt><dd>{profile.currentTitle}, {profile.currentCompany}</dd></div>
          <div><dt class="label">Also</dt><dd>{profile.studio.role}, <a class="link" href={profile.studio.url} data-cursor="Visit">{profile.studio.name}</a></dd></div>
        </dl>
      </div>
    </div>

    <a class="hero__scroll" href="#numbers" aria-label="Scroll down">
      <span class="label">Scroll</span>
      <span class="hero__scroll-line" aria-hidden="true"></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    z-index: var(--z-page);
    min-height: 100svh;
    display: flex;
    padding-top: 120px;
    padding-bottom: var(--s-7);
  }
  .hero__in {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 4vh, 48px);
    position: relative;
  }
  .hero__meta {
    display: flex;
    gap: var(--s-6);
    padding-bottom: var(--s-4);
    border-bottom: 1px solid var(--c-line);
  }
  .hero__who strong {
    color: var(--c-text);
    font-weight: 500;
  }
  .hero__meta-end {
    margin-left: auto;
  }
  .hero :global(.hero__title) {
    font-size: min(var(--t-display), 12.5svh);
    line-height: var(--lh-tight);
    letter-spacing: var(--tr-tight);
    font-weight: 500;
    margin-top: clamp(0px, 4vh, 48px);
    max-width: 17ch;
  }
  .hero :global(.hero__title em) {
    color: var(--c-accent-hi);
    padding-right: 0.06em;
  }
  .hero__foot {
    margin-top: auto;
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) auto minmax(0, 1fr);
    align-items: end;
    gap: var(--s-7);
  }
  .hero__summary {
    max-width: 52ch;
    font-size: clamp(1rem, 0.94rem + 0.3vw, 1.1875rem);
  }
  .hero__cta {
    display: flex;
    gap: var(--s-3);
    flex-wrap: wrap;
  }
  .hero__now {
    display: flex;
    gap: var(--s-4);
    align-items: center;
    justify-self: end;
  }

  .hero__ava {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    flex: none;
  }
  .hero__now dl {
    display: grid;
    gap: var(--s-2);
    font-size: var(--t-small);
  }
  .hero__now dl div {
    display: grid;
    grid-template-columns: 44px 1fr;
    align-items: baseline;
  }
  .hero__scroll {
    position: absolute;
    right: var(--gutter);
    top: 50%;
    display: none;
    flex-direction: column;
    align-items: center;
    gap: var(--s-3);
  }
  .hero__scroll .label {
    writing-mode: vertical-rl;
  }
  .hero__scroll-line {
    width: 1px;
    height: 64px;
    background: linear-gradient(var(--c-text), var(--c-text)) 0 0 / 1px 40% no-repeat, var(--c-line);
    animation: drip 2.2s var(--ease-in-out) infinite;
  }
  @keyframes drip {
    0% { background-position: 0 -40%; }
    100% { background-position: 0 140%; }
  }
  @media (min-width: 1280px) {
    .hero__scroll {
      display: flex;
    }
  }
  @media (max-width: 1080px) {
    .hero__foot {
      grid-template-columns: 1fr;
      gap: var(--s-6);
    }
    .hero__now {
      justify-self: start;
    }
  }
  @media (max-width: 640px) {
    .hero__meta .label:nth-child(2),
    .hero__meta-end {
      display: none;
    }
    .hero :global(.hero__title) {
      font-size: clamp(2.5rem, 11.5vw, 4rem);
    }
  }
</style>
